{
  "openInNewTab": true,
  "showDebug": true,
  "decimalPlaces": 4,
  "boards": [
    {
      "id": "f1-task-table",
      "name": "任务表（五子句）",
      "type": "功能示例",
      "description": "标准五子句查询：投影别名 + WHERE 过滤 + SORT 排序；表格双击单元格可直接改属性",
      "sql": "**TABLE_VIEW** **SELECT**\n  status **AS** 状态,\n  owner **AS** 负责人,\n  priority **AS** 优先级\n**FROM** \"示例/功能示例\"\n**WHERE** status %!=% '已完成'\n**SORT** priority **ASC**",
      "viewType": ""
    },
    {
      "id": "f2-status-by",
      "name": "状态机优先级",
      "type": "功能示例",
      "description": "标签数据源 + SORT BY 自定义优先级（已完成 > 待办 > 进行中）",
      "sql": "**TABLE_VIEW** **SELECT** file.name **AS** 任务, status **AS** 状态\n**FROM** #task\n**SORT** status **BY** ('已完成', '待办', '进行中')",
      "viewType": ""
    },
    {
      "id": "f3-backlink-list",
      "name": "反查链接（列表）",
      "type": "功能示例",
      "description": "LIST 视图：谁链接了 任务A（file.outlinks 反查）",
      "sql": "**LIST_VIEW**\n**FROM** \"示例/功能示例\"\n**WHERE** **contains**(file.outlinks, \"示例/功能示例/任务A.md\")",
      "viewType": ""
    },
    {
      "id": "f4-bool-date",
      "name": "布尔与日期",
      "type": "功能示例",
      "description": "布尔字段真值过滤 blocked，日期字段排序 due",
      "sql": "**SELECT** file.name **AS** 名称, due **AS** 截止, blocked **AS** 阻塞\n**FROM** \"示例/功能示例\"\n**WHERE** blocked\n**SORT** due **ASC**",
      "viewType": ""
    },
    {
      "id": "f5-all-cols",
      "name": "全字段自动列",
      "type": "功能示例",
      "description": "省略 SELECT 列表用 *，自动取结果里出现过的字段",
      "sql": "**TABLE_VIEW** **SELECT** *\n**FROM** \"示例/功能示例\"",
      "viewType": ""
    },
    {
      "id": "m1-arithmetic",
      "name": "四则与连接",
      "type": "数学示例",
      "description": "投影四则运算：单价×数量+运费；字符串连接 %||%",
      "sql": "**TABLE_VIEW** **SELECT**\n  file.name **AS** 名称,\n  价格 %*% 数量 **AS** 小计,\n  价格 %*% 数量 %+% 运费 **AS** 总价,\n  '订单：' %||% file.name **AS** 标注\n**FROM** \"示例/数学示例\"\n**SORT** 价格 %*% 数量 **DESC**",
      "viewType": ""
    },
    {
      "id": "m2-power-mod",
      "name": "乘方与取模",
      "type": "数学示例",
      "description": "乘方 %^% 右结合、取模 %%%；除零/类型不匹配非致命为 null",
      "sql": "**SELECT** file.name **AS** 名称,\n  底数 %^% 指数 **AS** 幂,\n  价格 %%% 数量 **AS** 余数,\n  价格 %/% (数量 %-% 数量) **AS** 除零演示\n**FROM** \"示例/数学示例\"",
      "viewType": ""
    },
    {
      "id": "m3-functions",
      "name": "内置函数",
      "type": "数学示例",
      "description": "sqrt / cbrt / root / length 函数演示",
      "sql": "**SELECT** file.name **AS** 名称,\n  **sqrt**(数值) **AS** 平方根,\n  **cbrt**(数值) **AS** 立方根,\n  **root**(数值, 4) **AS** 四次方根\n**FROM** \"示例/数学示例\"\n**SORT** 数值 **DESC**",
      "viewType": ""
    },
    {
      "id": "m4-compare",
      "name": "比较与逻辑",
      "type": "数学示例",
      "description": "比较运算符族 + AND/OR/NOT 组合（AND 优先）",
      "sql": "**SELECT** file.name **AS** 名称, 价格 **AS** 物品价格, 数量 **AS** 物品数量\n**FROM** \"示例/数学示例\"\n**WHERE** 价格 %>=% 7 **AND** **NOT** (数量 %>% 4 **OR** 价格 %==% 25)",
      "viewType": ""
    },
    {
      "id": "d1-omit-select",
      "name": "省略 SELECT",
      "type": "DSQL语言示例",
      "description": "SELECT 可省略（默认 * 全字段自动列），FROM 是唯一必填子句",
      "sql": "**FROM** \"示例/DSQL语言示例\"",
      "viewType": ""
    },
    {
      "id": "d2-scramble",
      "name": "子句乱序",
      "type": "DSQL语言示例",
      "description": "FROM → LIMIT → SORT → WHERE：只要求 FROM 是 WHERE/SORT/LIMIT 的前件，书写顺序自由",
      "sql": "**FROM** \"示例/功能示例\" **LIMIT** 5 **SORT** priority **DESC** **WHERE** status %!=% '已完成'",
      "viewType": ""
    },
    {
      "id": "d3-without-id",
      "name": "WITHOUT ID 任意位置",
      "type": "DSQL语言示例",
      "description": "WITHOUT ID 隐藏文件列，可写在任意子句位置",
      "sql": "**FROM** \"示例/功能示例\" **WITHOUT** **ID** **LIMIT** 3",
      "viewType": ""
    },
    {
      "id": "d4-identifier",
      "name": "中文标识符与字段缺失",
      "type": "DSQL语言示例",
      "description": "中文直接写字段名；引用不存在的字段整列为 —，调试信息出现 FIELD 条目",
      "sql": "**SELECT** file.name **AS** 名称, 涉及人物 **AS** 人物, 不存在的字段 **AS** 缺失\n**FROM** \"示例/DSQL语言示例\"",
      "viewType": ""
    },
    {
      "id": "d5-empty-by",
      "name": "空 BY 警告",
      "type": "DSQL语言示例",
      "description": "空 BY () 视为无自定义优先级，调试信息出现 WARN 条目",
      "sql": "**SELECT** file.name **AS** 任务, status **AS** 状态\n**FROM** \"示例/功能示例\"\n**SORT** status **BY** ()",
      "viewType": ""
    },
    {
      "id": "m5-total-summary",
      "name": "汇总行（TOTAL 计数与求和）",
      "type": "数学示例",
      "description": "SELECT 仅含 TOTAL 项 → 单行汇总；TOTAL 1 计数（COUNT 等价）+ 派生平均",
      "sql": "**TABLE_VIEW** **SELECT**\n  **TOTAL** 1 **AS** $笔记数$,\n  **TOTAL** 价格 **AS** $总价格$,\n  ($总价格$ %/% $笔记数$) **AS** $均价$\n**FROM** \"示例/数学示例\"",
      "viewType": ""
    },
    {
      "id": "m6-total-ratio",
      "name": "占比（TOTAL 忽略 WHERE）",
      "type": "数学示例",
      "description": "WHERE 只过滤显示行，TOTAL 恒为全表口径：各行价格占全表总价格的百分比",
      "sql": "**TABLE_VIEW** **SELECT**\n  file.name **AS** 名称,\n  价格,\n  **TOTAL** 价格 **AS** $全表总价格$,\n  (价格 %/% $全表总价格$) %*% 100 **AS** $占比$\n**FROM** \"示例/数学示例\"\n**WHERE** 价格 %>=% 7\n**SORT** 价格 **DESC**",
      "viewType": ""
    },
    {
      "id": "23cf6f29-c74f-423b-9606-b29bcc80fd83",
      "name": "三值展示（三行全部输出，缺失字段显示为 —）",
      "type": "三值示例",
      "description": "DSQL 1.5：三行全部输出，不做 WHERE 过滤；缺失的「数量」「开关」字段在该行显示为 —（null/empty 自然为空）。正常零值行数量=0 保留，开关=false 保留",
      "sql": "**SELECT** file.name **AS** 名称, 数量, 价格, 开关\n**FROM** \"示例/三值示例\"\n**SORT** 价格 **DESC**",
      "viewType": ""
    },
    {
      "id": "86cd9f31-1761-4f34-bc64-37d3102293c9",
      "name": "empty 谓词与三值传播",
      "type": "三值示例",
      "description": "DSQL 1.5：empty() 仅认未赋值；算术/连接 empty→null；比较 null/empty→false；0 照常运算",
      "sql": "**TABLE_VIEW** **SELECT**\n  file.name **AS** 名称,\n  **empty**(未填) **AS** 未填是empty,\n  **empty**(备注) **AS** 空串是empty,\n  未填 %+% 1 **AS** empty算术,\n  备注 %||% 'x' **AS** null连接,\n  未填 %==% null **AS** empty等于null,\n  数量 %+% 1 **AS** 零值照常\n**FROM** \"示例/三值示例\"\n**SORT** 价格 **DESC**",
      "viewType": ""
    },
    {
      "id": "c1-card-task",
      "name": "任务卡片（CARD 视图）",
      "type": "功能示例",
      "description": "CARD_VIEW：网格卡片，每张卡片显示一行；点击字段值直接编辑",
      "sql": "**CARD_VIEW** **SELECT**\n  status **AS** 状态,\n  owner **AS** 负责人,\n  priority **AS** 优先级\n**FROM** \"示例/功能示例\"\n**WHERE** status %!=% '已完成'\n**SORT** priority **ASC**",
      "viewType": "CARD_VIEW"
    },
    {
      "id": "c2-card-math",
      "name": "数学卡片（CARD 视图）",
      "type": "数学示例",
      "description": "CARD_VIEW：展示每条记录的字段与计算结果；点击编辑基础字段，派生列只读",
      "sql": "**CARD_VIEW** **SELECT**\n  file.name **AS** 名称,\n  价格,\n  数量,\n  (价格 %*% 数量) **AS** 小计\n**FROM** \"示例/数学示例\"\n**SORT** 价格 **DESC**",
      "viewType": "CARD_VIEW"
    }
  ]
}